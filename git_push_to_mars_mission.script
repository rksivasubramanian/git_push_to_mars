%--------------------------------------------------------------------------
% NASA GMAT Mission Script — Generated by Team Git Push to Mars
% Coordinate Reference System: EarthMJ2000Eq
%--------------------------------------------------------------------------
Create Spacecraft GitPushSat;
GMAT GitPushSat.DateFormat = UTCGregorian;
GMAT GitPushSat.Epoch = '15 Nov 2026 12:00:00.000';
GMAT GitPushSat.CoordinateSystem = EarthMJ2000Eq;
GMAT GitPushSat.DisplayStateType = Keplerian;
GMAT GitPushSat.SMA = 7083.14;
GMAT GitPushSat.ECC = 0.0012;
GMAT GitPushSat.INC = 98.20;
GMAT GitPushSat.DryMass = 473.6;
GMAT GitPushSat.Cd = 2.2;
GMAT GitPushSat.DragArea = 12.0;

Create ChemicalTank MainPropTank;
GMAT MainPropTank.FuelMass = 620.0;

Create ChemicalThruster MainEngine;
GMAT MainEngine.C1 = 440.0;
GMAT MainEngine.K1 = 322.0;
GMAT MainEngine.Tank = {MainPropTank};
GMAT GitPushSat.Tanks = {MainPropTank};
GMAT GitPushSat.Thrusters = {MainEngine};

Create GroundStation DSN_Station;
GMAT DSN_Station.CentralBody = Earth;
GMAT DSN_Station.Id = 'DSN 34m Beam-Waveguide';

Create ForceModel DeepSpaceFM;
GMAT DeepSpaceFM.CentralBody = Earth;
GMAT DeepSpaceFM.PrimaryBodies = {Earth};
GMAT DeepSpaceFM.PointMasses = {Sun, Earth, Luna, Mars};

Create Propagator RK89Prop;
GMAT RK89Prop.FM = DeepSpaceFM;
GMAT RK89Prop.Type = RungeKutta89;

BeginMissionSequence;
Propagate 'OrbitalSciencePhase' RK89Prop(GitPushSat) {GitPushSat.ElapsedDays = 1095};
